# =============================================================================
# Real Estate Lead Bot — Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env
# =============================================================================

# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_leads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security / Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-n8n-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider (example — adjust to chosen provider)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Google Sheets (optional operational reporting)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notifications (optional)
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend (Vite / React)
VITE_API_BASE_URL=http://localhost:8000/api/v1
